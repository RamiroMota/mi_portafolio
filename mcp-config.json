{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"]
    },
    "docfork": {
      "command": "npx",
      "args": ["-y", "docfork"]
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db", "mcp_debug.db"]
    },
    "Graphiti": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-graphiti-mcp"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
